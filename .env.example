# Environment: development | production
NODE_ENV=

# Server settings
# i.e.:
#   PORT=5000
#   HOST=0.0.0.0 (listen to all interfaces, you probably want this in LAN)
PORT=
HOST=

# Use only if you are going to make manual database queries
# PGUSER=
# PGHOST=
# PGPASSWORD=
# PGDATABASE=
# PGPORT=

# Follow this template:
# postgresql://user:password@host:port/dabatase
DATABASE_URL=

# Please use a string of a minimum length of 256 characters
# To generate a random one run one of the following in a terminal:
# openssl rand -hex 128
# node -e "console.log(require('crypto').randomBytes(128).toString('hex'))
JWT_SECRET=